{
  "opencollection": "1.0.0",
  "info": {
    "name": "Belvo Accounts Institutions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Institutions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all institutions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.belvo.com/api/institutions/",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of items per page (max 1000)."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number of results to return."
              }
            ]
          },
          "docs": "List all institutions"
        },
        {
          "info": {
            "name": "Get an institution's details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.belvo.com/api/institutions/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Get an institution's details"
        }
      ]
    }
  ],
  "bundled": true
}